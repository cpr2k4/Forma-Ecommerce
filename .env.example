DATABASE_URL="postgresql://ecommerce:ecommerce@localhost:5433/ecommerce?schema=public"
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="7d"
PORT=5050
CLIENT_URL="http://localhost:5173"

# Razorpay test keys from https://dashboard.razorpay.com/app/keys (Test Mode)
RAZORPAY_KEY_ID="rzp_test_..."
RAZORPAY_KEY_SECRET="..."

# Google OAuth client ID from https://console.cloud.google.com/apis/credentials
# (OAuth client type: "Web application"). Same value goes in client/.env as VITE_GOOGLE_CLIENT_ID.
GOOGLE_CLIENT_ID="your-client-id.apps.googleusercontent.com"
